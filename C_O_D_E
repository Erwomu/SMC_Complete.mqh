CSMCTradingSystem* g_SMCSystem = NULL;

//+------------------------------------------------------------------+
//|                    HELPER FUNCTIONS                              |
//+------------------------------------------------------------------+
bool InitializeSMCSystem(string symbol, ENUM_TIMEFRAMES htf, ENUM_TIMEFRAMES ltf)
{
    if(g_SMCSystem != NULL)
        delete g_SMCSystem;
    
    g_SMCSystem = new CSMCTradingSystem();
    
    if(!g_SMCSystem.Initialize(symbol, htf, ltf))
    {
        delete g_SMCSystem;
        g_SMCSystem = NULL;
        return false;
    }
    
    return true;
}

void UpdateSMCSystem()
{
    if(g_SMCSystem == NULL)
        return;
    
    g_SMCSystem.UpdateMarketStructure();
    g_SMCSystem.UpdateZones();
    g_SMCSystem.FilterZones();
    g_SMCSystem.UpdateDashboard();
    g_SMCSystem.CheckSymbolButtonClicks();
}

bool CheckSMCSignal()
{
    if(g_SMCSystem == NULL)
        return false;
    
    return g_SMCSystem.ShouldExecuteTrade();
}

bool ExecuteSMCTrade()
{
    if(g_SMCSystem == NULL)
        return false;
    
    return g_SMCSystem.ExecuteTrade();
}

void DestroySMCSystem()
{
    if(g_SMCSystem != NULL)
    {
        delete g_SMCSystem;
        g_SMCSystem = NULL;
    }
}

