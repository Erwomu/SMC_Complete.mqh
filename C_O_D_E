struct StructureState
{
    double lastHH;           // Last Higher High
    double lastHL;           // Last Higher Low  
    double lastLH;           // Last Lower High
    double lastLL;           // Last Lower Low
    bool   isBullish;        // Current market bias
    bool   isInitialized;    // Structure initialization status
    
    void Reset()
    {
        lastHH = 0.0;
        lastHL = 0.0;
        lastLH = 0.0;
        lastLL = 0.0;
        isBullish = true;
        isInitialized = false;
    }
};

struct OrderBlock
{
    double          high;
    double          low;
    double          bodyHigh;
    double          bodyLow;
    datetime        time;
    bool            isBullish;
    bool            isMitigated;
    bool            isValid;
    bool            filteredOut;
    ENUM_TIMEFRAMES timeframe;
    
    void Reset()
    {
        high = 0.0;
        low = 0.0;
        bodyHigh = 0.0;
        bodyLow = 0.0;
        time = 0;
        isBullish = false;
        isMitigated = false;
        isValid = false;
        filteredOut = false;
        timeframe = PERIOD_CURRENT;
    }
};

struct FVGZone
{
    double          upper;
    double          lower;
    datetime        created;
    bool            isBullish;
    bool            isValid;
    bool            filteredOut;
    ENUM_TIMEFRAMES timeframe;
    
    void Reset()
    {
        upper = 0.0;
        lower = 0.0;
        created = 0;
        isBullish = false;
        isValid = false;
        filteredOut = false;
        timeframe = PERIOD_CURRENT;
    }
};

struct LiquidityZone
{
    double   price;
    datetime time;
    bool     isHigh;
    bool     isSwept;
    
    void Reset()
    {
        price = 0.0;
        time = 0;
        isHigh = false;
        isSwept = false;
    }
};

struct SMC_Settings
{
    ENUM_TIMEFRAMES HTF;                 // Higher TimeFrame
    ENUM_TIMEFRAMES LTF;                 // Lower TimeFrame
    bool            useEngulfing;        // Use engulfing pattern filter
    bool            usePinBar;            // Use pin bar pattern filter
    bool            requireInternalBoS;   // Require internal Break of Structure
    bool            requireLiquiditySweep; // Require liquidity sweep
    bool            enableOBs;            // Enable Order Blocks
    bool            enableFVGs;           // Enable Fair Value Gaps
    double          obWeight;             // Order Block scoring weight
    double          fvgWeight;            // FVG scoring weight
    double          atrMultiplier;       // ATR multiplier for stop loss
    double          rrTarget;             // Risk-Reward target ratio
    double          lotSize;              // Trading lot size
    int             magicNumber;         // EA magic number
    int             slippage;             // Maximum slippage
};

//+------------------------------------------------------------------+
//|                      CLASS DEFINITION                            |
//+------------------------------------------------------------------+
class CSMCTradingSystem
{
private:
    // Core Variables
    string          m_symbol;
    ENUM_TIMEFRAMES m_HTF;
    ENUM_TIMEFRAMES m_LTF;
    
    // Market Structure States
    StructureState  m_HTFStructure;
    StructureState  m_LTFStructure;
    StructureState  m_InternalStructure;
    
    // Liquidity & Zones
    LiquidityZone   m_liquidityZone;
    OrderBlock      m_recentOBs[];
    FVGZone         m_recentFVGs[];
    
    // Settings
    SMC_Settings    m_settings;
    
    // Dashboard Variables
    string          m_symbolList[];
    int             m_selectedSymbolIndex;
    
    // Constants
    static const int MAX_OBS = 10;
    static const int MAX_FVGS = 10;
    
    // Private Methods
    bool   InitializeStructure(ENUM_TIMEFRAMES tf, int bars, StructureState &state);
    bool   UpdateStructureLogic(ENUM_TIMEFRAMES tf, StructureState &state);
    void   DetectOrderBlocksInternal(ENUM_TIMEFRAMES tf, int lookback);
    void   DetectFVGZonesInternal(ENUM_TIMEFRAMES tf, int scanBars);
    bool   ZonesOverlap(double top1, double bottom1, double top2, double bottom2);
    void   FilterOverlappingOBs();
    void   FilterOverlappingFVGs();
    int    GetBestOrderBlockIndex(bool isBullish);
    int    GetBestFVGIndex(bool isBullish);
    bool   IsPinBarPattern(bool bullish, ENUM_TIMEFRAMES tf);
    bool   IsEngulfingPattern(bool bullish, ENUM_TIMEFRAMES tf);
    bool   UpdateInternalBreakOfStructure(ENUM_TIMEFRAMES tf, bool bias);
    double CalculateATR(ENUM_TIMEFRAMES tf, int period);
    
public:
    // Constructor & Destructor
    CSMCTradingSystem();
    ~CSMCTradingSystem();
    
    // Initialization
    bool   Initialize(string symbol, ENUM_TIMEFRAMES htf, ENUM_TIMEFRAMES ltf);
    void   SetParameters(const SMC_Settings &settings);
    
    // Core Trading Functions
    void   UpdateMarketStructure();
    void   UpdateZones();
    void   FilterZones();
    bool   ShouldExecuteTrade();
    bool   ExecuteTrade();
    
    // Zone Detection
    bool   IsBestOrderBlockTapped(int &index, bool bias);
    bool   IsBestFVGTapped(int &index, bool bias);
    
    // Dashboard Functions
    void   CreateDashboard();
    void   UpdateDashboard();
    void   CheckSymbolButtonClicks();
    void   SwitchSymbol(int index);
    
    // Getters
    bool   GetHTFBias() const { return m_HTFStructure.isBullish; }
    bool   GetLTFBias() const { return m_LTFStructure.isBullish; }
    string GetCurrentSymbol() const { return m_symbol; }
};

