void CSMCTradingSystem::CreateDashboard()
{
    // Create main panel
    string panelName = "SMC_PANEL";
    ObjectCreate(0, panelName, OBJ_RECTANGLE_LABEL, 0, 0, 0);
    ObjectSetInteger(0, panelName, OBJPROP_CORNER, CORNER_LEFT_UPPER);
    ObjectSetInteger(0, panelName, OBJPROP_XDISTANCE, 10);
    ObjectSetInteger(0, panelName, OBJPROP_YDISTANCE, 30);
    ObjectSetInteger(0, panelName, OBJPROP_XSIZE, 280);
    ObjectSetInteger(0, panelName, OBJPROP_YSIZE, 200);
    ObjectSetInteger(0, panelName, OBJPROP_BGCOLOR, clrBlack);
    ObjectSetInteger(0, panelName, OBJPROP_BORDER_TYPE, BORDER_RAISED);
    ObjectSetInteger(0, panelName, OBJPROP_BORDER_COLOR, clrDarkGray);
    ObjectSetInteger(0, panelName, OBJPROP_BACK, true);
    
    // Create symbol buttons
    int buttonX = 10;
    for(int i = 0; i < ArraySize(m_symbolList); i++)
    {
        string buttonId = "SYM_BTN_" + IntegerToString(i);
        ObjectCreate(0, buttonId, OBJ_BUTTON, 0, 0, 0);
        ObjectSetInteger(0, buttonId, OBJPROP_CORNER, CORNER_LEFT_UPPER);
        ObjectSetInteger(0, buttonId, OBJPROP_XDISTANCE, buttonX);
        ObjectSetInteger(0, buttonId, OBJPROP_YDISTANCE, 5);
        ObjectSetInteger(0, buttonId, OBJPROP_XSIZE, 85);
        ObjectSetInteger(0, buttonId, OBJPROP_YSIZE, 22);
        ObjectSetInteger(0, buttonId, OBJPROP_FONTSIZE, 10);
        ObjectSetInteger(0, buttonId, OBJPROP_BGCOLOR, 
                        i == m_selectedSymbolIndex ? clrDarkGreen : clrDimGray);
        ObjectSetString(0, buttonId, OBJPROP_TEXT, m_symbolList[i]);
        ObjectSetString(0, buttonId, OBJPROP_FONT, "Arial");
        buttonX += 90;
    }
    
    UpdateDashboard();
}

void CSMCTradingSystem::UpdateDashboard()
{
    string labels[8];
    color colors[8];
    
    // Prepare display data
    string htfBias = m_HTFStructure.isBullish ? "BULLISH" : "BEARISH";
    string ltfBias = m_LTFStructure.isBullish ? "BULLISH" : "BEARISH";
    string internalBias = m_InternalStructure.isBullish ? "YES" : "NO";
    string liquiditySweep = m_liquidityZone.isSwept ? "YES" : "NO";
    bool execReady = ShouldExecuteTrade();
    
    labels[0] = "Symbol: " + m_symbol;
    labels[1] = "HTF Bias: " + htfBias;
    labels[2] = "LTF Bias: " + ltfBias;
    labels[3] = "Internal BoS: " + internalBias;
    labels[4] = "Liquidity Sweep: " + liquiditySweep;
    labels[5] = "Ready to Execute: " + (execReady ? "YES" : "NO");
    labels[6] = "Spread: " + IntegerToString((int)symbolInfo.Spread());
    labels[7] = "Time: " + TimeToString(TimeLocal(), TIME_MINUTES | TIME_SECONDS);
    
    colors[0] = clrWhite;
    colors[1] = m_HTFStructure.isBullish ? clrLime : clrTomato;
    colors[2] = m_LTFStructure.isBullish ? clrLime : clrTomato;
    colors[3] = m_InternalStructure.isBullish ? clrLime : clrRed;
    colors[4] = m_liquidityZone.isSwept ? clrOrange : clrGray;
    colors[5] = execReady ? clrDeepSkyBlue : clrDimGray;
    colors[6] = clrSilver;
    colors[7] = clrSilver;
    
    // Update labels
    int yPos = 45;
    for(int i = 0; i < 8; i++)
    {
        string labelId = "SMC_LABEL_" + IntegerToString(i);
        
        if(ObjectFind(0, labelId) < 0)
        {
            ObjectCreate(0, labelId, OBJ_LABEL, 0, 0, 0);
            ObjectSetInteger(0, labelId, OBJPROP_CORNER, CORNER_LEFT_UPPER);
            ObjectSetInteger(0, labelId, OBJPROP_XDISTANCE, 20);
            ObjectSetInteger(0, labelId, OBJPROP_FONTSIZE, 10);
            ObjectSetString(0, labelId, OBJPROP_FONT, "Arial");
        }
        
        ObjectSetInteger(0, labelId, OBJPROP_YDISTANCE, yPos);
        ObjectSetInteger(0, labelId, OBJPROP_COLOR, colors[i]);
        ObjectSetString(0, labelId, OBJPROP_TEXT, labels[i]);
        
        yPos += 20;
    }
    
    ChartRedraw(0);
}

void CSMCTradingSystem::CheckSymbolButtonClicks()
{
    for(int i = 0; i < ArraySize(m_symbolList); i++)
    {
        string buttonId = "SYM_BTN_" + IntegerToString(i);
        
        if(ObjectGetInteger(0, buttonId, OBJPROP_STATE))
        {
            SwitchSymbol(i);
            ObjectSetInteger(0, buttonId, OBJPROP_STATE, false);
            
            // Update button colors
            for(int j = 0; j < ArraySize(m_symbolList); j++)
            {
                string btnId = "SYM_BTN_" + IntegerToString(j);
                ObjectSetInteger(0, btnId, OBJPROP_BGCOLOR, 
                               j == i ? clrDarkGreen : clrDimGray);
            }
            break;
        }
    }
}

void CSMCTradingSystem::SwitchSymbol(int index)
{
    if(index >= 0 && index < ArraySize(m_symbolList))
    {
        m_selectedSymbolIndex = index;
        m_symbol = m_symbolList[index];
        
        // Reinitialize for new symbol
        Initialize(m_symbol, m_HTF, m_LTF);
        
        // Reset structures for new symbol
        m_HTFStructure.Reset();
        m_LTFStructure.Reset();
        m_InternalStructure.Reset();
        
        // Clear zones
        ArrayInitialize(m_recentOBs, 0);
        ArrayInitialize(m_recentFVGs, 0);
        
        Print("Switched to symbol: ", m_symbol);
    }
}

