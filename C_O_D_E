bool CSMCTradingSystem::Initialize(string symbol, ENUM_TIMEFRAMES htf, ENUM_TIMEFRAMES ltf)
{
    m_symbol = symbol;
    m_HTF = htf;
    m_LTF = ltf;
    
    if(!symbolInfo.Name(symbol))
    {
        Print("Failed to initialize symbol: ", symbol);
        return false;
    }
    
    trade.SetExpertMagicNumber(m_settings.magicNumber);
    trade.SetDeviationInPoints(m_settings.slippage);
    trade.SetTypeFilling(ORDER_FILLING_IOC);
    
    // Initialize market structures
    InitializeStructure(m_HTF, 30, m_HTFStructure);
    InitializeStructure(m_LTF, 30, m_LTFStructure);
    
    return true;
}

void CSMCTradingSystem::SetParameters(const SMC_Settings &settings)
{
    m_settings = settings;
    trade.SetExpertMagicNumber(m_settings.magicNumber);
    trade.SetDeviationInPoints(m_settings.slippage);
}

bool CSMCTradingSystem::InitializeStructure(ENUM_TIMEFRAMES tf, int bars, StructureState &state)
{
    double high[], low[];
    ArraySetAsSeries(high, true);
    ArraySetAsSeries(low, true);
    
    if(CopyHigh(m_symbol, tf, 0, bars, high) < bars || 
       CopyLow(m_symbol, tf, 0, bars, low) < bars)
    {
        Print("Failed to copy price data for structure initialization");
        return false;
    }
    
    int highestIndex = ArrayMaximum(high, 0, bars);
    int lowestIndex = ArrayMinimum(low, 0, bars);
    
    state.lastHH = high[highestIndex];
    state.lastLL = low[lowestIndex];
    state.lastHL = state.lastLL;
    state.lastLH = state.lastHH;
    state.isBullish = true;
    state.isInitialized = true;
    
    return true;
}

bool CSMCTradingSystem::UpdateStructureLogic(ENUM_TIMEFRAMES tf, StructureState &state)
{
    if(!state.isInitialized)
        return InitializeStructure(tf, 30, state);
    
    double high[], low[], close[];
    ArraySetAsSeries(high, true);
    ArraySetAsSeries(low, true);
    ArraySetAsSeries(close, true);
    
    if(CopyHigh(m_symbol, tf, 0, 5, high) < 5 || 
       CopyLow(m_symbol, tf, 0, 5, low) < 5 || 
       CopyClose(m_symbol, tf, 0, 5, close) < 5)
    {
        return false;
    }
    
    double recentHigh = high[1];
    double recentLow = low[1];
    bool structureChanged = false;
    
    if(state.isBullish)
    {
        // Check for bearish break of structure
        if(close[1] < state.lastHL)
        {
            state.isBullish = false;
            state.lastLH = recentHigh;
            state.lastLL = recentLow;
            Print("Bearish BoS Detected on ", EnumToString(tf));
            structureChanged = true;
        }
        else if(recentHigh > state.lastHH)
        {
            state.lastHH = recentHigh;
            state.lastHL = recentLow;
        }
    }
    else
    {
        // Check for bullish break of structure
        if(close[1] > state.lastLH)
        {
            state.isBullish = true;
            state.lastHH = recentHigh;
            state.lastHL = recentLow;
            Print("Bullish BoS Detected on ", EnumToString(tf));
            structureChanged = true;
        }
        else if(recentLow < state.lastLL)
        {
            state.lastLL = recentLow;
            state.lastLH = recentHigh;
        }
    }
    
    return structureChanged;
}

void CSMCTradingSystem::UpdateMarketStructure()
{
    UpdateStructureLogic(m_HTF, m_HTFStructure);
    UpdateStructureLogic(m_LTF, m_LTFStructure);
}

void CSMCTradingSystem::DetectOrderBlocksInternal(ENUM_TIMEFRAMES tf, int lookback)
{
    double open[], close[], high[], low[];
    ArraySetAsSeries(open, true);
    ArraySetAsSeries(close, true);
    ArraySetAsSeries(high, true);
    ArraySetAsSeries(low, true);
    
    if(CopyOpen(m_symbol, tf, 0, lookback, open) < lookback ||
       CopyClose(m_symbol, tf, 0, lookback, close) < lookback ||
       CopyHigh(m_symbol, tf, 0, lookback, high) < lookback ||
       CopyLow(m_symbol, tf, 0, lookback, low) < lookback)
    {
        return;
    }
    
    // Clear existing order blocks for this timeframe
    for(int i = 0; i < ArraySize(m_recentOBs); i++)
    {
        if(m_recentOBs[i].timeframe == tf)
            m_recentOBs[i].Reset();
    }
    
    int obCount = 0;
    for(int i = 2; i < lookback - 1 && obCount < MAX_OBS; i++)
    {
        double body = MathAbs(close[i] - open[i]);
        double nextBody = MathAbs(close[i-1] - open[i-1]);
        
        // Bullish Order Block
        if(close[i] < open[i] && close[i-1] > open[i-1] && nextBody > 1.5 * body)
        {
            OrderBlock ob;
            ob.high = high[i];
            ob.low = low[i];
            ob.bodyHigh = MathMax(open[i], close[i]);
            ob.bodyLow = MathMin(open[i], close[i]);
            ob.time = iTime(m_symbol, tf, i);
            ob.isBullish = true;
            ob.isMitigated = false;
            ob.isValid = true;
            ob.filteredOut = false;
            ob.timeframe = tf;
            
            // Find empty slot
            for(int j = 0; j < ArraySize(m_recentOBs); j++)
            {
                if(!m_recentOBs[j].isValid)
                {
                    m_recentOBs[j] = ob;
                    obCount++;
                    break;
                }
            }
        }
        
        // Bearish Order Block
        if(close[i] > open[i] && close[i-1] < open[i-1] && nextBody > 1.5 * body)
        {
            OrderBlock ob;
            ob.high = high[i];
            ob.low = low[i];
            ob.bodyHigh = MathMax(open[i], close[i]);
            ob.bodyLow = MathMin(open[i], close[i]);
            ob.time = iTime(m_symbol, tf, i);
            ob.isBullish = false;
            ob.isMitigated = false;
            ob.isValid = true;
            ob.filteredOut = false;
            ob.timeframe = tf;
            
            // Find empty slot
            for(int j = 0; j < ArraySize(m_recentOBs); j++)
            {
                if(!m_recentOBs[j].isValid)
                {
                    m_recentOBs[j] = ob;
                    obCount++;
                    break;
                }
            }
        }
    }
}

void CSMCTradingSystem::DetectFVGZonesInternal(ENUM_TIMEFRAMES tf, int scanBars)
{
    double high[], low[];
    ArraySetAsSeries(high, true);
    ArraySetAsSeries(low, true);
    
    if(CopyHigh(m_symbol, tf, 0, scanBars, high) < scanBars ||
       CopyLow(m_symbol, tf, 0, scanBars, low) < scanBars)
    {
        return;
    }
    
    // Clear existing FVGs for this timeframe
    for(int i = 0; i < ArraySize(m_recentFVGs); i++)
    {
        if(m_recentFVGs[i].timeframe == tf)
            m_recentFVGs[i].Reset();
    }
    
    int fvgCount = 0;
    for(int i = 2; i < scanBars - 1 && fvgCount < MAX_FVGS; i++)
    {
        // Bullish FVG
        if(low[i-2] > high[i])
        {
            FVGZone fvg;
            fvg.lower = high[i];
            fvg.upper = low[i-2];
            fvg.created = iTime(m_symbol, tf, i);
            fvg.isBullish = true;
            fvg.isValid = true;
            fvg.filteredOut = false;
            fvg.timeframe = tf;
            
            // Find empty slot
            for(int j = 0; j < ArraySize(m_recentFVGs); j++)
            {
                if(!m_recentFVGs[j].isValid)
                {
                    m_recentFVGs[j] = fvg;
                    fvgCount++;
                    break;
                }
            }
        }
        
        // Bearish FVG
        if(high[i-2] < low[i])
        {
            FVGZone fvg;
            fvg.upper = low[i];
            fvg.lower = high[i-2];
            fvg.created = iTime(m_symbol, tf, i);
            fvg.isBullish = false;
            fvg.isValid = true;
            fvg.filteredOut = false;
            fvg.timeframe = tf;
            
            // Find empty slot
            for(int j = 0; j < ArraySize(m_recentFVGs); j++)
            {
                if(!m_recentFVGs[j].isValid)
                {
                    m_recentFVGs[j] = fvg;
                    fvgCount++;
                    break;
                }
            }
        }
    }
}

bool CSMCTradingSystem::ZonesOverlap(double top1, double bottom1, double top2, double bottom2)
{
    return !(bottom1 > top2 || top1 < bottom2);
}

void CSMCTradingSystem::FilterOverlappingOBs()
{
    for(int i = 0; i < ArraySize(m_recentOBs); i++)
    {
        if(!m_recentOBs[i].isValid || m_recentOBs[i].filteredOut)
            continue;
        
        for(int j = i + 1; j < ArraySize(m_recentOBs); j++)
        {
            if(!m_recentOBs[j].isValid || m_recentOBs[j].filteredOut)
                continue;
            
            if(m_recentOBs[i].isBullish != m_recentOBs[j].isBullish)
                continue;
            
            if(ZonesOverlap(m_recentOBs[i].high, m_recentOBs[i].low, 
                          m_recentOBs[j].high, m_recentOBs[j].low))
            {
                if(m_recentOBs[i].time > m_recentOBs[j].time)
                    m_recentOBs[j].filteredOut = true;
                else
                    m_recentOBs[i].filteredOut = true;
            }
        }
    }
}

void CSMCTradingSystem::FilterOverlappingFVGs()
{
    for(int i = 0; i < ArraySize(m_recentFVGs); i++)
    {
        if(!m_recentFVGs[i].isValid || m_recentFVGs[i].filteredOut)
            continue;
        
        for(int j = i + 1; j < ArraySize(m_recentFVGs); j++)
        {
            if(!m_recentFVGs[j].isValid || m_recentFVGs[j].filteredOut)
                continue;
            
            if(m_recentFVGs[i].isBullish != m_recentFVGs[j].isBullish)
                continue;
            
            if(ZonesOverlap(m_recentFVGs[i].upper, m_recentFVGs[i].lower,
                          m_recentFVGs[j].upper, m_recentFVGs[j].lower))
            {
                if(m_recentFVGs[i].created > m_recentFVGs[j].created)
                    m_recentFVGs[j].filteredOut = true;
                else
                    m_recentFVGs[i].filteredOut = true;
            }
        }
    }
}

int CSMCTradingSystem::GetBestOrderBlockIndex(bool isBullish)
{
    int bestIndex = -1;
    double bestScore = -999999.0;
    double currentPrice = symbolInfo.Bid();
    
    for(int i = 0; i < ArraySize(m_recentOBs); i++)
    {
        if(!m_recentOBs[i].isValid || m_recentOBs[i].filteredOut)
            continue;
        
        if(m_recentOBs[i].isBullish != isBullish)
            continue;
        
        double distance = MathAbs(currentPrice - m_recentOBs[i].bodyHigh);
        double tfWeight = (m_recentOBs[i].timeframe == m_HTF) ? 1.3 : 1.0;
        double agePenalty = (TimeCurrent() - m_recentOBs[i].time) / 3600.0; // in hours
        
        double score = -distance * 10000 + 200 + tfWeight * (100 * m_settings.obWeight) - agePenalty;
        
        if(score > bestScore)
        {
            bestScore = score;
            bestIndex = i;
        }
    }
    
    return bestIndex;
}

int CSMCTradingSystem::GetBestFVGIndex(bool isBullish)
{
    int bestIndex = -1;
    double bestScore = -999999.0;
    double currentPrice = symbolInfo.Bid();
    
    for(int i = 0; i < ArraySize(m_recentFVGs); i++)
    {
        if(!m_recentFVGs[i].isValid || m_recentFVGs[i].filteredOut)
            continue;
        
        if(m_recentFVGs[i].isBullish != isBullish)
            continue;
        
        double distance = MathAbs(currentPrice - m_recentFVGs[i].lower);
        double tfWeight = (m_recentFVGs[i].timeframe == m_HTF) ? 1.2 : 1.0;
        double agePenalty = (TimeCurrent() - m_recentFVGs[i].created) / 3600.0;
        
        double score = -distance * 8000 + 100 + tfWeight * (80 * m_settings.fvgWeight) - agePenalty;
        
        if(score > bestScore)
        {
            bestScore = score;
            bestIndex = i;
        }
    }
    
    return bestIndex;
}

bool CSMCTradingSystem::IsBestOrderBlockTapped(int &index, bool bias)
{
    index = GetBestOrderBlockIndex(bias);
    if(index < 0)
        return false;
    
    double price = symbolInfo.Bid();
    return (price <= m_recentOBs[index].bodyHigh && price >= m_recentOBs[index].bodyLow);
}

bool CSMCTradingSystem::IsBestFVGTapped(int &index, bool bias)
{
    index = GetBestFVGIndex(bias);
    if(index < 
